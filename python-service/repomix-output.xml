from typing import Dict, Any, List
from app.ai.schemas import StructuredQuotationResponse
import logging

logger = logging.getLogger("quotation_validators")

def validate_and_heal_quotation(res: StructuredQuotationResponse) -> StructuredQuotationResponse:
    """
    Validates mathematical relations within the structured quotation response and performs
    deterministic healing to guarantee logical consistency.
    """
    q = res.quotation
    services = res.services
    payment_terms = res.payment_terms

    # 1. Total Services Count Validation
    q.total_services = len(services)

    # 2. Total Manpower Aggregation
    calculated_manpower = 0
    for s in services:
        if s.manpower_count:
            calculated_manpower += s.manpower_count
    
    if not q.total_manpower or q.total_manpower != calculated_manpower:
        if calculated_manpower > 0:
            logger.info(f"Correcting total_manpower from {q.total_manpower} to calculated {calculated_manpower}")
            q.total_manpower = calculated_manpower

    # 3. Subtotals vs Grand Total Before GST
    calculated_grand_subtotal = 0
    for s in services:
        # Calculate subtotal if count, rate, and duration are defined
        if s.manpower_count and s.rate_per_manpower and s.duration_days:
            expected_sub = s.manpower_count * s.rate_per_manpower * s.duration_days
            if not s.subtotal_amount or s.subtotal_amount != expected_sub:
                s.subtotal_amount = expected_sub
        
        if s.subtotal_amount:
            calculated_grand_subtotal += s.subtotal_amount

    if not q.grand_total_before_gst or q.grand_total_before_gst != calculated_grand_subtotal:
        if calculated_grand_subtotal > 0:
            logger.info(f"Healing grand_total_before_gst from {q.grand_total_before_gst} to calculated {calculated_grand_subtotal}")
            q.grand_total_before_gst = calculated_grand_subtotal

    # 4. GST Mathematics Healing
    if q.grand_total_before_gst:
        gst_pct = q.gst_percentage or 18 # Standard fallback
        expected_gst_amount = int(q.grand_total_before_gst * (gst_pct / 100.0))
        
        if not q.gst_amount or abs(q.gst_amount - expected_gst_amount) > 10:
            q.gst_amount = expected_gst_amount
            q.gst_percentage = gst_pct

        expected_final = q.grand_total_before_gst + q.gst_amount
        if not q.final_total_after_gst or abs(q.final_total_after_gst - expected_final) > 10:
            q.final_total_after_gst = expected_final

    # 5. Payment Percentage Safety Check
    pct_sum = sum(pt.percentage for pt in payment_terms)
    if pct_sum > 0 and pct_sum != 100:
        warning_msg = f"CRITICAL: Payment terms percentage sum ({pct_sum}%) does not equal 100%."
        if warning_msg not in q.financial_risks:
            q.financial_risks.append(warning_msg)

    # 6. Default Confidence
    if not q.extraction_confidence:
        q.extraction_confidence = 0.95

    return res
